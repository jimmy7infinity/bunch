{
  "buildCommand": "cd website && npm install && npm run build",
  "outputDirectory": "website/dist",
  "installCommand": "echo 'Skipping root install'",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
