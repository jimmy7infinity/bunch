# Local Development Environment Variables
# Copy this to .env and fill in with your local values
# NEVER commit .env file to git!

NODE_ENV=development
PORT=3000

# MongoDB - Use local MongoDB or your own test database
MONGODB_URI=mongodb://localhost:27017/bunch

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets - Generate your own with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-local-dev-secret-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-local-refresh-secret-here
JWT_REFRESH_EXPIRES_IN=30d

# URLs
FRONTEND_URL=http://localhost:5173
EXTENSION_URL=chrome-extension://*
API_PREFIX=api
