{
  "manifest_version": 3,
  "name": "PolyBanter",
  "version": "0.1.0",
  "description": "Social chat for Polymarket - Connect with traders in real-time",
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://polymarket.com/*",
    "http://localhost:3000/*",
    "https://*.railway.app/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://polymarket.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://poly-banter.up.railway.app/auth-success.html*"],
      "js": ["auth-content-script.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open PolyBanter",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "externally_connectable": {
    "matches": [
      "https://poly-banter.up.railway.app/*",
      "http://localhost:3000/*"
    ]
  }
}



